@page "/orders/new"
@page "/orders/{Id:guid}"
@using System.ComponentModel
@using Design.App.Components
@using Design.App.ViewModels
@using Design.Domain.Aggregates.OrderAggregate
@inject OrderEditViewModel Vm
@implements IDisposable

<PageTitle>Order</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h4" Class="mb-4">Order</MudText>

        @if (Vm.Order is null)
        {
            <MudText>Loading...</MudText>
        }
        else
        {
            @* begin-snippet: skill-page-order-edit *@
            @* @key: Save returns a new instance; keying on it rebuilds the bound
               components so each field subscribes to the new instance's wrappers. *@
            <div @key="Vm.Order">
            @* The page binds each field to the entity's property wrapper. The
               component reads the wrapper's value, messages, IsBusy and IsReadOnly;
               nothing here validates or decides. *@
            <NeatooValidationSummary Entity="@Vm.Order" Class="mb-4" />

            <MudNeatooTextField T="string" EntityProperty="@Vm.Order[nameof(IOrder.OrderNumber)]" Class="mb-3" />
            <MudNeatooTextField T="string" EntityProperty="@Vm.Order[nameof(IOrder.CustomerName)]" Class="mb-3" />
            <MudNeatooDatePicker EntityProperty="@Vm.Order[nameof(IOrder.OrderDate)]" Class="mb-3" />

            <MudText Typo="Typo.h6" Class="my-3">Items</MudText>

            @* begin-snippet: skill-mud-child-collection *@
            @if (Vm.Order.Items is not null)
            {
                @foreach (var item in Vm.Order.Items)
                {
                    @* Each row is a component that refreshes for its own item. *@
                    <OrderItemEditor @key="item" Item="@item" OnRemove="@(() => Vm.RemoveItem(item))" />
                }
            }
            @* end-snippet *@

            <MudButton Variant="Variant.Outlined" OnClick="Vm.AddItem" Class="mb-3">Add Item</MudButton>

            <MudText Typo="Typo.subtitle1" Class="mb-3">Total: @Vm.Order.TotalAmount.ToString("C")</MudText>

            @* The Save button is enabled by the entity's own answer. *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!Vm.CanSave)"
                       OnClick="SaveAsync">
                Save
            </MudButton>
            </div>
            @* end-snippet *@
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid? Id { get; set; }

    private IOrder? _subscribed;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is Guid id)
        {
            await Vm.Load(id);
        }
        else
        {
            await Vm.New();
        }

        Resubscribe();
    }

    // The page shows the order's own facts outside any input (TotalAmount, the
    // Save button's IsSavable), so it re-renders on the order's own PropertyChanged:
    // its own properties and meta flags. An item's facts are its row's to show.
    private void Resubscribe()
    {
        if (_subscribed is not null)
        {
            _subscribed.PropertyChanged -= OnEntityChanged;
        }

        _subscribed = Vm.Order;

        if (_subscribed is not null)
        {
            _subscribed.PropertyChanged += OnEntityChanged;
        }
    }

    // Save returns a new instance; the old one raises nothing afterwards, so
    // the page moves its subscription itself and re-renders for the new state.
    private async Task SaveAsync()
    {
        await Vm.Save();
        Resubscribe();
        StateHasChanged();
    }

    private void OnEntityChanged(object? sender, PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.PropertyChanged -= OnEntityChanged;
        }
    }
}
